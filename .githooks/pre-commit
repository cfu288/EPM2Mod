#!/bin/sh
# Checks before a commit. Enable once per clone: git config core.hooksPath .githooks
#
# 1. Refuse machine-specific details in the staged changes: home-directory paths, session
#    scratch paths, user@host targets. Use placeholders (/path/to/..., USER@HOST, /tmp/scratch).
# 2. For the production code (src/epm2mod, tests): format the staged files with black and
#    stage the result; then type-check the package with mypy. Needs uv; without uv this
#    part is skipped with a warning.
pattern='/home/[A-Za-z0-9._-]+/|/Users/[A-Za-z0-9._-]+/|/tmp/claude-[0-9]+|-home-[a-z0-9]+-|[A-Za-z0-9._-]+@[A-Za-z0-9-]+:[/~]'
allow='USER@HOST:|git@github\.com:|/home/user/|/Users/user/'
hits=$(git diff --cached -U0 --no-color --diff-filter=AM -- . ':(exclude).githooks' | grep -E '^\+' | grep -v -E '^\+\+\+ ' | grep -E "$pattern" | grep -v -E "$allow" | head -5)
if [ -n "$hits" ]; then
  echo "pre-commit: machine-specific paths or hosts in the staged changes (use /path/to, USER@HOST, /tmp/scratch):" >&2
  printf '%s\n' "$hits" | cut -c1-160 >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=AM -- 'src/epm2mod/*.py' 'src/epm2mod/**/*.py' 'tests/test_package.py')
[ -z "$staged" ] && exit 0
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv not found; black and mypy were NOT run on the production code" >&2
  exit 0
fi
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
# A file with unstaged changes on top of staged ones cannot be formatted safely.
for f in $staged; do
  if ! git diff --quiet -- "$f"; then
    echo "pre-commit: $f has unstaged changes; stage or stash them so black can format the file" >&2
    exit 1
  fi
done
# shellcheck disable=SC2086
uv run --quiet black --quiet $staged || { echo "pre-commit: black failed" >&2; exit 1; }
# shellcheck disable=SC2086
git add -- $staged
if ! uv run --quiet mypy; then
  echo "pre-commit: mypy found type errors in src/epm2mod" >&2
  exit 1
fi
exit 0
