# firmware and build outputs are never committed
# (case-insensitive: files also pass through macOS, where Foo.Bin and foo.bin are the same file)
*.[Bb][Ii][Nn]
*.[Ll][Zz][Mm][Aa]
*.[Zz][Ii][Pp]
*.7z
build/
firmware/**/*
!firmware/README.md
!firmware/SHA256SUMS
!firmware/*/
!firmware/*/*/

# assembler/linker output from the disassembly tools, if written outside build/
*.o
*.elf

# experiment outputs
experiments/**/out/

__pycache__/
*.pyc
.venv/

# the local app page, built from web/ (npm run build:app); the release zip carries it
src/epm2mod/app/
.DS_Store

# om-emu is the submodule third_party/om-emu, our fork (branch e101) with the E-PM2's boot lab.
# Unpacked images (build/emu) are under build/, ignored above.
# Old diffs made before om-emu had a licence stay out:
**/om-emu-E101.patch
**/om-emu-changes.diff

# Third-party reference documents (manuals, parts lists). Not redistributable; never commit.
/references/
