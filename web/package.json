{
  "name": "epm2mod-web",
  "private": true,
  "version": "1.0.0",
  "description": "The web parts of EPM2Mod: the shared package (packages/ui), the public site (apps/site) and the local app (apps/local)",
  "type": "module",
  "engines": {
    "node": "26.7.0"
  },
  "workspaces": [
    "packages/ui",
    "apps/site",
    "apps/local"
  ],
  "scripts": {
    "dev": "npm run dev -w @epm2mod/site",
    "dev:app": "npm run dev -w @epm2mod/local",
    "build": "npm run build -w @epm2mod/site -w @epm2mod/local",
    "build:site": "npm run build -w @epm2mod/site",
    "build:app": "npm run build -w @epm2mod/local",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b packages/ui apps/site apps/local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node need-node.mjs && npm run test --workspaces",
    "check": "node need-node.mjs && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "node need-node.mjs && npm run e2e -w @epm2mod/site -w @epm2mod/local"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
